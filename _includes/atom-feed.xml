{%- assign feed_lang = include.feed_lang | default: "en" -%}
{%- assign feed_ui = site.data.ui[feed_lang] -%}
{%- if feed_lang == "ru" -%}{%- assign feed_base = "/ru" -%}{%- else -%}{%- assign feed_base = "" -%}{%- endif -%}
{%- assign feed_url = feed_base | append: "/feed.xml" | absolute_url -%}
{%- assign feed_posts = site.posts | where: "lang", feed_lang -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ feed_lang }}">
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <link href="{{ feed_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ feed_base | append: '/blog/' | absolute_url }}" rel="alternate" type="text/html" hreflang="{{ feed_lang }}" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ feed_url }}</id>
  <title>{{ feed_ui.feed_title | xml_escape }}</title>
  <subtitle>{{ feed_ui.feed_subtitle | xml_escape }}</subtitle>
  <author>
    <name>{{ site.author.name | xml_escape }}</name>
    <uri>{{ site.author.url }}</uri>
  </author>
{%- for post in feed_posts limit: 20 %}
  <entry xml:lang="{{ feed_lang }}">
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html" title="{{ post.title | xml_escape }}" />
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <id>{{ post.url | absolute_url }}</id>
    <summary type="html">{{ post.description | default: post.excerpt | strip_html | xml_escape }}</summary>
    <content type="html" xml:base="{{ post.url | absolute_url }}">{{ post.content | xml_escape }}</content>
  </entry>
{%- endfor %}
</feed>
