---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign sitemap_pages = site.pages | where_exp: "page", "page.sitemap != false" %}{% for page in sitemap_pages %}{% assign page_robots = page.robots | default: 'index, follow' %}{% unless page_robots contains 'noindex' %}{% if page.url and page.url != '/sitemap.xml' and page.url != '/yandex_0eeb4655093624d8.html' %}
  <url>
    <loc>{{ page.url | absolute_url }}</loc>
    {% if page.last_modified_at %}<lastmod>{{ page.last_modified_at | date_to_xmlschema }}</lastmod>{% elsif page.date %}<lastmod>{{ page.date | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
{% endif %}{% endunless %}{% endfor %}{% assign sitemap_posts = site.posts | where_exp: "post", "post.sitemap != false" %}{% for post in sitemap_posts %}{% assign post_robots = post.robots | default: 'index, follow' %}{% unless post_robots contains 'noindex' %}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
    {% if post.last_modified_at %}<lastmod>{{ post.last_modified_at | date_to_xmlschema }}</lastmod>{% else %}<lastmod>{{ post.date | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
{% endunless %}{% endfor %}
</urlset>
