---
layout: null
permalink: /image-sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
{%- assign sm_langs = "en,ru" | split: "," -%}
{%- for l in sm_langs -%}
{%- if l == "ru" -%}{%- assign b = "/ru" -%}{%- assign suffix = " — состав Cult Of Maids" -%}{%- assign cap_banner = "Баннер профиля Morui" -%}{%- assign cap_avatar = "Фото профиля Morui" -%}{%- assign cap_emblem = "Эмблема Cult Of Maids" -%}
{%- else -%}{%- assign b = "" -%}{%- assign suffix = " — Cult Of Maids roster" -%}{%- assign cap_banner = "Morui profile banner" -%}{%- assign cap_avatar = "Morui profile photo" -%}{%- assign cap_emblem = "Cult Of Maids emblem" -%}{%- endif %}
  <url>
    <loc>{{ b | append: "/" | absolute_url }}</loc>
    <image:image><image:loc>{{ "/assets/img/profile-banner.webp" | absolute_url }}</image:loc><image:caption>{{ cap_banner }}</image:caption><image:title>Morui</image:title></image:image>
    <image:image><image:loc>{{ "/assets/img/morui-avatar.webp" | absolute_url }}</image:loc><image:caption>{{ cap_avatar }}</image:caption><image:title>Morui</image:title></image:image>
  </url>
  <url>
    <loc>{{ b | append: "/team/" | absolute_url }}</loc>
    <image:image><image:loc>{{ "/assets/img/cult-of-maids.webp" | absolute_url }}</image:loc><image:caption>{{ cap_emblem }}</image:caption><image:title>Cult Of Maids</image:title></image:image>
{%- for member in site.data.roster %}
{%- assign sm_name = member.name -%}{%- if l == "ru" and member.name_ru -%}{%- assign sm_name = member.name_ru -%}{%- endif %}
    <image:image><image:loc>{{ "/assets/img/roster/" | append: member.avatar | append: ".webp" | absolute_url }}</image:loc><image:caption>{{ sm_name | xml_escape }}{{ suffix }}</image:caption><image:title>{{ sm_name | xml_escape }}</image:title></image:image>
{%- endfor %}
  </url>
  <url>
    <loc>{{ b | append: "/archive/" | absolute_url }}</loc>
{%- for member in site.data.roster %}
{%- assign sm_name = member.name -%}{%- if l == "ru" and member.name_ru -%}{%- assign sm_name = member.name_ru -%}{%- endif -%}
{%- if member.name == "Morui" -%}{%- assign sm_img = "/assets/img/morui-avatar-512.webp" -%}{%- else -%}{%- assign sm_img = "/assets/img/roster/" | append: member.avatar | append: ".webp" -%}{%- endif %}
    <image:image><image:loc>{{ sm_img | absolute_url }}</image:loc><image:caption>{{ sm_name | xml_escape }}{{ suffix }}</image:caption><image:title>{{ sm_name | xml_escape }}</image:title></image:image>
{%- endfor %}
  </url>
{%- endfor %}
</urlset>
